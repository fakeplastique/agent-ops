DATABASE_URL=postgresql+asyncpg://app_rt:app_rt@localhost:5432/agent_ops
MIGRATE_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/agent_ops
REDIS_URL=redis://localhost:6379/0
# Read at `next build` (rewrites are baked in), not at runtime
API_ORIGIN=http://localhost:8000

# Receipt signing keys, kid:secret[,kid:secret]; the last signs, all verify; secrets 32+ chars. Required on Railway.
# RECEIPT_KEYS=prod1:replace-with-a-long-random-secret-32chars-min
# Webhook secret encryption (AES-256-GCM), kid:base64(32 bytes)[,...]; the last seals, all open. Required on Railway.
# Generate one: python -c "import base64,os;print('prod1:'+base64.b64encode(os.urandom(32)).decode())"
# WEBHOOK_SECRET_KEYS=prod1:...
# Local dev only (refused on Railway): let webhooks target plain http receivers.
# WEBHOOKS_ALLOW_HTTP=false
# Telegram bot (BotFather). No token = no messages; no webhook secret = the webhook answers 404.
# Register: setWebhook url=<api>/api/v1/telegram/webhook secret_token=<TELEGRAM_WEBHOOK_SECRET> (A-Z a-z 0-9 _ -)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_BOT_USERNAME=

# Org admins may switch their own plan (demo deployments only).
# DEMO_MODE=false
# Comma-separated emails of platform admins (may change any organization's plan).
# PLATFORM_ADMIN_EMAILS=
# Shared secret for GET /metrics (header X-Metrics-Token); unset = the route answers 404.
# METRICS_TOKEN=
