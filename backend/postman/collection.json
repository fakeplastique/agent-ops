        {
          "name": "receipt",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/decision-requests/{{lifecycleId}}/receipt"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 signed receipt for this request', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.have.all.keys('alg', 'kid', 'payload', 'signature');",
                  "  pm.expect(JSON.stringify(b.payload)).to.include(pm.environment.get('lifecycleId'));",
                  "  pm.environment.set('receipt', pm.response.text());",
                  "  const s = b.signature;",
                  "  const forged = Object.assign({}, b, { signature: (s[0] === 'A' ? 'B' : 'A') + s.slice(1) });",
                  "  pm.environment.set('forged', JSON.stringify(forged));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "verify receipt",
          "request": {
            "method": "POST",
