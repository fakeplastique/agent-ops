            "url": "{{baseUrl}}/api/v1/decision-requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{run}} lifecycle\",\n  \"description\": \"newman\",\n  \"action_type\": \"refund\",\n  \"payload\": {\n    \"amount\": 5\n  },\n  \"risk_level\": \"low\"\n}"
