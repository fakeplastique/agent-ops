    {
      "name": "pagination",
      "item": [
        {
          "name": "create page item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{requesterToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/decision-requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{run}} page\",\n  \"description\": \"newman\",\n  \"action_type\": \"note\",\n  \"payload\": {\n    \"amount\": 5\n  },\n  \"risk_level\": \"low\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const n = Number(pm.environment.get('pageMade') || 0) + 1;",
                  "pm.environment.set('pageMade', n);",
                  "if (n < 5) postman.setNextRequest('create page item');"
                ]
              }
            }
          ]
        },
        {
          "name": "walk pages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{requesterToken}}"
              }
            ],
            "url": "{{pageUrl}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('200 page of at most 2', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(b.limit).to.eql(2);",
                  "  pm.expect(b.items.length).to.be.at.most(2);",
                  "});",
                  "const seen = JSON.parse(pm.environment.get('pageSeen') || '[]').concat(b.items.map(i => i.id));",
                  "pm.environment.set('pageSeen', JSON.stringify(seen));",
                  "const pages = Number(pm.environment.get('pages') || 0) + 1;",
                  "pm.environment.set('pages', pages);",
                  "if (b.nextLink && pages < 10) {",
                  "  pm.environment.set('pageUrl', b.nextLink);",
                  "  postman.setNextRequest('walk pages');",
                  "} else {",
                  "  pm.test('nextLink walked every item exactly once', () => {",
                  "    pm.expect(b.nextLink, 'nextLink still set after 10 pages').to.be.null;",
                  "    pm.expect(b.total).to.eql(5);",
                  "    pm.expect(pages).to.eql(3);",
                  "    pm.expect(seen.length).to.eql(5);",
                  "    pm.expect(new Set(seen).size).to.eql(5);",
                  "  });",
                  "}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// the first page; later ones follow nextLink (capped at 10 so a loop cannot hang the run)",
                  "if (!pm.environment.get('pageUrl')) {",
                  "  pm.environment.set('pageUrl', pm.variables.replaceIn('{{baseUrl}}/api/v1/decision-requests?q={{run}} page&limit=2'));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
