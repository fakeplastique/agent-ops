{
  "info": {
    "name": "Agent Ops API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:8000" }],
  "item": [
    {
      "name": "healthz",
      "request": { "method": "GET", "url": "{{baseUrl}}/healthz" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 and ok', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "readyz",
      "request": { "method": "GET", "url": "{{baseUrl}}/readyz" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 with both dependencies up', () => {",
              "  pm.response.to.have.status(200);",
              "  const b = pm.response.json();",
              "  pm.expect(b.checks).to.eql({ postgres: true, redis: true });",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
