                  "  pm.expect(b.status).to.eql('pending_votes');",
                  "  pm.expect(b.version).to.eql(1);",
                  "  pm.expect(pm.response.headers.get('Location')).to.eql('/api/v1/decision-requests/' + b.id);",
                  "  pm.environment.set('lifecycleId', b.id);",
