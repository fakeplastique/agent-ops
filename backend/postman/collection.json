{
  "info": {
    "name": "Agent Ops API",
    "description": "Run by scripts/gate.sh against a live API; credentials come from backend/postman/seed.py.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "health",
      "item": [
        {
          "name": "healthz",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/healthz"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 and ok', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "readyz",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/readyz"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 with both dependencies up', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().checks).to.eql({ postgres: true, redis: true });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "errors",
      "item": [
        {
          "name": "401 without a credential",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/decision-requests"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 unauthenticated in the error envelope', () => {",
                  "  pm.response.to.have.status(401);",
                  "  const e = pm.response.json().error;",
                  "  pm.expect(e).to.have.all.keys('code', 'message', 'details');",
                  "  pm.expect(e.code).to.eql('unauthenticated');",
                  "  pm.expect(e.message).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "404 unknown request",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{requesterToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/decision-requests/00000000-0000-4000-8000-000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 not_found in the error envelope', () => {",
                  "  pm.response.to.have.status(404);",
                  "  const e = pm.response.json().error;",
                  "  pm.expect(e).to.have.all.keys('code', 'message', 'details');",
                  "  pm.expect(e.code).to.eql('not_found');",
                  "  pm.expect(e.message).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "422 missing title",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{requesterToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/decision-requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"newman\",\n  \"action_type\": \"refund\",\n  \"payload\": {\n    \"amount\": 5\n  },\n  \"risk_level\": \"low\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('422 invalid_input in the error envelope', () => {",
                  "  pm.response.to.have.status(422);",
                  "  const e = pm.response.json().error;",
                  "  pm.expect(e).to.have.all.keys('code', 'message', 'details');",
                  "  pm.expect(e.code).to.eql('invalid_input');",
                  "  pm.expect(e.message).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('details lists the field', () => {",
                  "  pm.expect(JSON.stringify(pm.response.json().error.details)).to.include('title');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
